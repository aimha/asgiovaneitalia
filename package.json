{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build --mode staging",
    "buildProd": "vite build --mode production",
    "serve": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && npm run format:check",
    "lint:fix": "eslint . --fix && npm run format",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"docs/**/*.md\"",
    "prepare": "husky"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx}": ["eslint --fix", "prettier --write"]
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-solid": "^0.14.5",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "sass": "^1.85.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@smoovy/scroller": "^2.2.2",
    "@solidjs/router": "^0.15.3",
    "solid-js": "^1.9.3"
  }
}
